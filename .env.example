# Copy this file to .env. Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
APP_ENV=development
DATABASE_URL=postgresql://omnicalc:omnicalc@localhost:5432/omnicalc
ALLOWED_ORIGINS=http://localhost:5173
# Keep blank for the Docker/Nginx same-origin build. A standalone Vite dev server can set this in frontend/.env.local.
VITE_API_BASE_URL=

# Authentication. Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=omnicalc-api
JWT_AUDIENCE=omnicalc-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Planned live-data integrations (not required by the current release)
EXCHANGE_RATE_API_KEY=
WOLFRAM_APP_ID=
